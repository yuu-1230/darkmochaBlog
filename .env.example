# GitHub Contribution Graph (app/about)
# 1. https://github.com/settings/tokens で Fine-grained token を発行（read-only, 期限を設定推奨）
# 2. ローカルでは .env.local に、Vercel では Project Settings > Environment Variables に設定する
# 3. この値は絶対に Public リポジトリへコミットしない

GITHUB_TOKEN=
GITHUB_USERNAME=

# Site images except the local favicon (Cloudflare R2 custom domain)
# Omit to use https://images.darkmocha.dev.
NEXT_PUBLIC_IMAGE_BASE_URL=https://images.darkmocha.dev

# Blog likes (Neon PostgreSQL)
# Run db/migrations/001_create_post_likes.sql before enabling the feature.
DATABASE_URL=
# Generate with: openssl rand -base64 32
LIKE_HASH_SECRET=
